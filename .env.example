# Beta Elasticsearch cluster (use ES API port 9200 — NOT Kibana 5601)
# Use https:// if the node has TLS enabled (http often returns empty reply).
BETA_ES_URL=https://beta-es:9200
BETA_ES_USER=elastic
BETA_ES_PASSWORD=changeme

# Stage Elasticsearch cluster (use ES API port 9200 — NOT Kibana 5601)
STAGE_ES_URL=http://stage-es:9200
STAGE_ES_USER=elastic
STAGE_ES_PASSWORD=changeme

# Shared client options
ES_VERIFY_CERTS=false
ES_TIMEOUT=30

# Set to true to also inspect the Beta cluster (default: Stage-only)
ENABLE_BETA=false

# Optional: limit compare to team(s) or exact service prefixes
# PREFIX_FILTER=mic
# PREFIX_FILTER=mic,cd
# PREFIX_FILTER=mic-api,mic-ava

# Optional: pin compare to a calendar day's indices (YYYY-MM-DD)
# INDEX_DATE=2026-07-28
