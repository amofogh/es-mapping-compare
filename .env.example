# Elasticsearch / ELK cluster (use ES API port 9200 — NOT Kibana 5601)
# Use https:// if the node has TLS enabled (http often returns empty reply).
ES_URL=http://elasticsearch:9200
ES_USER=elastic
ES_PASSWORD=changeme

# Shared client options
ES_VERIFY_CERTS=false
ES_TIMEOUT=30

# Optional: limit analyze/discover to team(s) or exact service prefixes
# PREFIX_FILTER=mic
# PREFIX_FILTER=mic,cd
# PREFIX_FILTER=mic-api,mic-ava

# Optional: pin analysis to a calendar day's indices (YYYY-MM-DD)
# INDEX_DATE=2026-07-28
